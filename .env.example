# Copy this file to .env.local and fill in the values from your Supabase project.
# .env.local is private: it is ignored by git and never uploaded to GitHub.

# Supabase dashboard → Project Settings → Data API (or "Connect") → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase dashboard → Project Settings → API Keys → "Publishable key" (safe for the browser)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase dashboard → Project Settings → API Keys → "Secret key" (server only — keep private!)
SUPABASE_SECRET_KEY=sb_secret_xxx

# Supabase dashboard → "Connect" button → "Session pooler" connection string (works on IPv4 networks).
# Replace [YOUR-PASSWORD] with the database password you chose when creating the project.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres
